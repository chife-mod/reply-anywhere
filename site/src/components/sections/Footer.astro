---
// Footer v3 — 2026-07-26, rebuilt to the client's actual reference (the SF
// Group footer): the footer is a row of BIG island cards sitting 4px apart —
// the same .island primitive and the same gap the menu uses, scaled up to
// cards. v2 (every link its own micro-tile) read wrong and was rejected.
// Composition mirrors the reference: brand tiles + a claim card on the left,
// a navigation card in the middle, a CTA card on the right. Only links that
// lead somewhere real today are listed (client: «нам нужен реальный футер») —
// a new section earns its place when it ships. Channel discs removed 2026-07-26
// (client: discs read as company socials, misread). Chrome is 100% shared:
// Button, tokens (DESIGN.md §0).
import Button from '../ui/Button.astro';
import logoMark from '../../assets/brand/logo-mark.svg';
import wordmark from '../../assets/brand/wordmark.svg';

// The honest link set (2026-07-26): Product mirrors the menu 1:1 (client:
// «то же самое отражаем в футере»), minus Contact — that anchor IS this
// footer. No #cases / #pricing / #privacy / #terms until those destinations
// exist. #demo stays site-wide CTA policy (index.astro).
const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Channels', href: '#channels' },
      { label: 'Features', href: '#features' },
      { label: 'Compare', href: '#compare' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'Semantic Force', href: 'https://semanticforce.ai', external: true },
      { label: 'Omnichannel HelpDesk', href: 'https://semanticforce.ai/products/omnichannel-helpdesk', external: true },
    ],
  },
];

const year = 2026; // build-time constant — no client-side date drift
---

<footer class="footer" id="contact">
  <div class="footer__glow" aria-hidden="true"></div>

  <div class="footer__inner">
    <div class="footer__grid">
      <!-- ── Left column: the menu's brand islands, landed + claim card ── -->
      <div class="footer__left">
        <div class="footer__islands">
          <span class="island footer__logo">
            <img src={logoMark.src} width="45" height="40" alt="" />
          </span>
          <span class="island footer__wordmark">
            <img src={wordmark.src} width="102" height="33" alt="Reply Anywhere" />
            <span class="footer__tagline">Product of SemanticForce</span>
          </span>
        </div>
        <div class="island footer__card footer__card--claim">
          <p class="footer__claim">
            One workspace for every customer conversation — reviews, comments,
            direct messages and questions, answered anywhere.
          </p>
          <p class="footer__copy">
            © {year} Reply Anywhere — a product of
            <a href="https://semanticforce.ai" target="_blank" rel="noopener">Semantic Force</a>.
          </p>
        </div>
      </div>

      <!-- ── Middle card: navigation ── -->
      <div class="island footer__card footer__card--nav">
        <nav class="footer__cols" aria-label="Footer">
          {columns.map((col) => (
            <div class="footer__col">
              <h2 class="footer__col-title">{col.title}</h2>
              <ul role="list">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.external ? '_blank' : undefined}
                      rel={l.external ? 'noopener' : undefined}
                    >{l.label}{l.external && <span class="footer__ext" aria-hidden="true"> ↗</span>}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>

      <!-- ── Right card: CTA ── -->
      <div class="island footer__card footer__card--cta">
        <p class="footer__cta-title">Ready to reply anywhere?</p>
        <div class="footer__cta-actions">
          <Button href="#demo" label="Request a free demo" />
          <span class="footer__cta-hint">14-day trial · no card · cancel anytime</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    /* X only: the glow must never widen the page, but it may bleed UP into
       the section above — the hairline border and the hard clip cut it into
       a visible bar (client 2026-07-26: «уберём палку, пусть переходит
       плавно; кусочек таблицы на свечении — не страшно»). */
    overflow-x: clip;
    overflow-y: visible;
    padding: var(--sp-20) var(--margin-desktop) var(--sp-10);
  }
  /* One soft violet wash behind the brand — the site's signature glow, at its
     quietest (pre-blurred square idiom, DESIGN.md §6). */
  /* A soft radial wash that starts ABOVE the footer edge and fades in every
     direction — no rectangle, no seam. radial-gradient instead of a blurred
     square: a blur is clipped by its own box, a gradient is not. */
  .footer__glow {
    position: absolute;
    z-index: -1;
    left: max(var(--margin-desktop), 2%);
    top: -220px;
    width: min(760px, 70%);
    height: 620px;
    background: radial-gradient(
      50% 50% at 50% 50%,
      rgba(171, 13, 255, 0.22) 0%,
      rgba(171, 13, 255, 0.1) 45%,
      rgba(171, 13, 255, 0) 72%
    );
    pointer-events: none;
  }
  .footer__inner {
    max-width: var(--container);
    margin-inline: auto;
  }

  /* ── The card row: menu islands scaled up, same 4px gap ── */
  .footer__grid {
    display: grid;
    /* Side cards squeeze 340→260 before the row gives up (client 2026-07-26:
       «плитки резиновые»). The nav card's floor is min-content — the grid
       breaks to 2 columns rather than clipping the longest link. */
    grid-template-columns: minmax(260px, 340px) minmax(min-content, 1fr) minmax(260px, 340px);
    align-items: stretch;
    gap: var(--sp-1); /* the menu's own 4px floor between islands */
  }
  .footer__card {
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--sp-8);
    padding: var(--sp-8);
  }

  /* ── Left: brand islands + claim card ── */
  .footer__left {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }
  .footer__islands {
    display: flex;
    gap: var(--sp-1);
    width: 100%;
  }
  .footer__islands .island { height: var(--sp-16); }
  .footer__logo {
    justify-content: center;
    padding: var(--sp-3) var(--sp-4);
  }
  .footer__logo img { width: 44.571px; height: 40px; }
  .footer__wordmark {
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: var(--sp-2) var(--sp-45);
  }
  .footer__wordmark img { width: 101.945px; height: 33px; }
  .footer__tagline {
    font-size: var(--fs-pill-label); /* settled exception to the 13px floor */
    line-height: var(--lh-body);
    color: var(--text-tagline);
    white-space: nowrap;
  }
  .footer__card--claim { flex: 1; }
  .footer__claim {
    font-size: var(--fs-card-sub);
    line-height: var(--lh-body);
    color: var(--text-dim);
  }
  .footer__copy {
    font-size: var(--fs-chip);
    line-height: var(--lh-body);
    color: var(--text-dim);
  }
  .footer__copy a {
    color: var(--text-body);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__copy a:hover { color: var(--violet-light); }

  /* ── Middle card: link columns (ref idiom: dim small titles, bright links).
     max-content columns sit together (client 2026-07-26: 1fr spread them
     across the whole card — «очень много места»), and they stay TWO columns
     at every width — never a single tall list. ── */
  .footer__cols {
    display: grid;
    /* min-content floor, NOT 0: with a 0 floor the tracks kept shrinking past
       the longest word and the links spilled out of the card (client-caught
       2026-07-26). The floor propagates outward — the outer grid gives the
       nav card the width it needs, or breaks the row. */
    grid-template-columns: repeat(2, minmax(min-content, max-content));
    /* 64 at the design width, breathing down to the 32 floor on phones —
       one fluid rule instead of per-breakpoint overrides. */
    gap: var(--sp-8) clamp(var(--sp-8), 4.45vw, var(--sp-16));
  }
  .footer__col-title {
    font-size: var(--fs-chip);
    font-weight: var(--fw-medium);
    line-height: 1;
    color: var(--text-dim);
  }
  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    margin: var(--sp-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .footer__col a {
    font-size: var(--fs-ui);
    font-weight: var(--fw-medium);
    line-height: 1;
    color: var(--text-hi);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer__col a:hover { color: var(--text-body); }
  .footer__ext { color: var(--text-dim); }

  /* ── Right card: CTA ── */
  .footer__cta-title {
    font-size: var(--fs-card-title);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--text-hi);
  }
  .footer__cta-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
  }
  .footer__cta-hint {
    font-size: var(--fs-chip);
    color: var(--text-dim);
  }

  /* ── Adaptive: the site's ≤946 / ≤560 degrade rules ──
     3 cards in a row only where the container is at its full 1280 (≥1440) —
     on narrower desktops the middle card would squeeze under the disc row. */
  @media (max-width: 1199px) {
    /* Measured: below 1200 «Omnichannel HelpDesk ↗» stops fitting on one line
       next to two side cards. The row could technically survive to ~1020 with
       wrapped links — it reads worse, so the grid breaks here instead
       (client 2026-07-26: тянем, пока красиво, потом перестраиваем).
       2-col grid + the CTA as a horizontal band. */
    .footer__grid {
      grid-template-columns: minmax(260px, 1fr) 1.4fr;
    }
    .footer__card--cta {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-8);
    }
    .footer__cta-title { max-width: 50%; }
  }
  @media (max-width: 760px) {
    /* Client 2026-07-26: the 2-col grid breathes fine well below 946 —
       stack only when the nav card genuinely runs out (~760). */
    .footer { padding-top: var(--sp-16); }
    .footer__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    /* (columns stay two-up — the fluid column-gap hits its 32px floor here) */
    .footer__card--cta {
      flex-direction: column;
      align-items: stretch;
    }
    .footer__cta-title { max-width: 100%; }
  }
</style>
