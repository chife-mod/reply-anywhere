---
// Channel pill (Figma 20:377 pattern — constellation section):
// rgba(0,0,0,.5) pill · pl4 pr16 py4 · gap 8 · black 48px disc with 24px logo ·
// two-line text: 10/1.2 @50% over 14/1.3 white.
import Icon from './Icon.astro';

interface Props {
  icon: string; // "logos/google-g" etc.
  category: string; // top line, e.g. "Company Reviews"
  name: string; // bottom line, e.g. "Google Reviews"
  iconWidth?: number; // non-square logos (google-maps)
  iconHeight?: number;
  variant?: 'dark' | 'social'; // Figma: dark rgba(0,0,0,.5) wave-1 · violet rgba(171,13,255,.2) wave-2
}
const { icon, category, name, iconWidth, iconHeight, variant = 'dark' } = Astro.props;
---

<div class:list={['pill', variant === 'social' && 'pill--social']}>
  <span class="pill__disc">
    <Icon name={icon} size={24} width={iconWidth} height={iconHeight} />
  </span>
  <span class="pill__text">
    <span class="pill__cat">{category}</span>
    <span class="pill__name">{name}</span>
  </span>
</div>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-1) var(--sp-4) var(--sp-1) var(--sp-1);
    background: var(--surface-pill);
    border-radius: var(--r-pill);
  }
  .pill--social { background: var(--surface-pill-social); }
  .pill__disc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--sp-10); /* Figma 19:215/41:4265: disc 40×40, icon 24 */
    height: var(--sp-10);
    background: var(--black);
    border-radius: var(--r-pill);
  }
  .pill__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    white-space: nowrap;
  }
  .pill__cat {
    font-size: var(--fs-pill-label);
    line-height: 1.2;
    color: var(--text-dim);
  }
  .pill__name {
    font-size: var(--fs-ui);
    line-height: 1.3;
    color: var(--text-hi);
  }

  /* Compact mode ≤560px (constellation cloud layout): the pill owns its own
     shrink so any consumer gets it for free. Category label (10px) drops —
     redundant once pills are stacked close together in the cloud — the disc
     steps down one Figma size (40 → 32), and the right-hand padding steps
     down one token (--sp-4 → --sp-3). Vertical/left padding stay at --sp-1 —
     already the smallest step on the spacing scale, nothing to tighten
     further. Name line stays --fs-ui (14px) — locked floor, never shrinks. */
  @media (max-width: 560px) {
    .pill {
      padding: var(--sp-1) var(--sp-3) var(--sp-1) var(--sp-1);
    }
    .pill__disc {
      width: var(--sp-8);
      height: var(--sp-8);
    }
    .pill__cat {
      display: none;
    }
  }
  /* Phones: all 13 tags now share the pinned screen with the headline, body
     and chips (scene rebuilt 2026-07-26) — at the ≤560 size they needed 7
     rows and ran into the copy. One step tighter: 24px disc, the caption
     floor (13) for the name, minimal padding. Fits in 4 rows at 390. */
  @media (max-width: 480px) {
    .pill {
      gap: var(--sp-1);
      padding: 2px var(--sp-2) 2px 2px; /* 2px = the disc's optical inset */
    }
    .pill__disc {
      width: var(--sp-6);
      height: var(--sp-6);
    }
    .pill__disc :global(img) {
      width: 16px;
      height: 16px;
    }
    .pill__name {
      font-size: var(--fs-chip);
    }
  }
  /* Small phones / short screens: 13 named tags cannot share a 700px screen
     with the headline, body and chips whatever the type size — so the tag
     becomes its DISC alone (the hero-orbit idiom). All 13 channels stay
     visible in two rows; their names are what the copy right above says. */
  @media (max-width: 430px), (max-height: 720px) and (max-width: 560px) {
    .pill {
      padding: 2px;
    }
    .pill__text {
      display: none;
    }
    .pill__disc {
      width: var(--sp-8);
      height: var(--sp-8);
    }
    .pill__disc :global(img) {
      width: 20px;
      height: 20px;
    }
  }
</style>
