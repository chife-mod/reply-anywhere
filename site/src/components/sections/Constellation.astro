---
// Channel constellation (Figma 19:215, 1440×650) — centered SectionHeading
// (20:361) orbited by 13 ChannelPills at exact Figma coordinates. Two pill
// fills in the design: default rgba(0,0,0,.5) and a violet accent
// rgba(171,13,255,.2) on 10 pills. data-constellation / data-constellation-pill
// are the Phase D motion hooks (float/parallax pass).
import SectionHeading from '../ui/SectionHeading.astro';
import ChannelPill from '../ui/ChannelPill.astro';

interface Pill {
  x: number; // absolute position inside the 1440×650 stage
  y: number;
  icon: string;
  category: string;
  name: string;
  iconWidth?: number; // non-square logos keep their Figma aspect
  iconHeight?: number;
  violet?: boolean; // rgba(171,13,255,.2) fill variant
}

// Layout rules, in order of authority:
// 1. The centre column (x 340–1100) belongs to the headline/body/chips below
//    y230 — pills only live on the TOP ARC (above the headline at 283) or on
//    the SIDE WINGS (left of ~340 / right of ~1110). Client 2026-07-21.
// 2. The FIRST WAVE (the three dark pills) is what the viewer sees first, so
//    it is a deliberate CENTRED ROW, not scatter — «слишком рандомно»,
//    client 2026-07-26. Row 1 = dark, centred on the stage axis (720) at
//    x-centres 460 / 720 / 980; row 2 = the violet wave right beneath it;
//    the remaining violets hold the wings. x below is the LEFT edge, i.e.
//    centre − measured width/2 (widths: 174/181/192 · 169/156/147/187).
const pills: Pill[] = [
  // ── wave 1: the opening row, centred under the menu ──
  { x: 373, y: 95, icon: 'logos/google-g', category: 'Company Reviews', name: 'Google Reviews' },
  { x: 630, y: 95, icon: 'logos/amazon', category: 'Product Reviews', name: 'Amazon Reviews' },
  { x: 884, y: 95, icon: 'logos/appstore', category: 'App Reviews', name: 'App Store Reviews', iconWidth: 24, iconHeight: 21 },
  // ── wave 2, row beneath it ──
  { x: 146, y: 185, icon: 'logos/ebay', category: 'Marketplace Reviews', name: 'eBay', iconWidth: 30, iconHeight: 12, violet: true },
  { x: 492, y: 185, icon: 'logos/google-maps', category: 'Location Reviews', name: 'Google Maps', iconWidth: 17, iconHeight: 24, violet: true },
  { x: 797, y: 185, icon: 'logos/messenger', category: 'Direct Messages', name: 'Messenger', violet: true },
  { x: 1117, y: 185, icon: 'logos/tiktok', category: 'Social Comments', name: 'TikTok Comments', iconWidth: 21, iconHeight: 24, violet: true },
  // ── wave 2, left wing ──
  { x: 171, y: 361, icon: 'logos/whatsapp', category: 'Direct Messages', name: 'WhatsApp', violet: true },
  { x: 90, y: 452, icon: 'logos/instagram', category: 'Social Comments', name: 'Instagram Comments', violet: true },
  { x: 150, y: 545, icon: 'logos/etsy', category: 'Marketplace Reviews', name: 'Etsy', violet: true },
  // ── wave 2, right wing ──
  { x: 1146, y: 361, icon: 'logos/instagram', category: 'Direct Messages', name: 'Instagram DMs', violet: true },
  { x: 1116, y: 452, icon: 'logos/trustpilot', category: 'Company Reviews', name: 'Trustpilot', iconWidth: 24, iconHeight: 23, violet: true },
  { x: 1120, y: 545, icon: 'logos/facebook', category: 'Social Comments', name: 'Facebook Comments', violet: true },
];
---

<section class="constellation" id="constellation" data-constellation data-scene-part="constellation">
  <div class="constellation__stage">
    <div class="constellation__heading" data-scene-el="headline">
      <SectionHeading
        line1="One platform for review management"
        accent="and social customer service"
      />
    </div>
    {/* One list per wave: the scatter positions each <li> absolutely so the
        split changes nothing there, but in cloud mode it gives the dark trio
        its own centred row with the violet wave beneath (client 2026-07-26:
        «три чёрных по центру, а фиолетовые дальше»). */}
    {[1, 2].map((wave) => (
      <ul class={`constellation__pills constellation__pills--w${wave}`} role="list">
        {pills.filter((p) => (p.violet ? 2 : 1) === wave).map((p) => (
          <li
            class:list={['constellation__spot', { 'constellation__spot--violet': p.violet }]}
            style={`--x: ${p.x}px; --y: ${p.y}px;`}
            data-constellation-pill
            data-scene-el="pill"
            data-wave={wave}
          >
            <ChannelPill
              icon={p.icon}
              category={p.category}
              name={p.name}
              iconWidth={p.iconWidth}
              iconHeight={p.iconHeight}
              variant={p.violet ? 'social' : 'dark'}
            />
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  /* Fixed 1440 stage centered in the viewport; wider screens get symmetric
     side bleed, narrower ones clip the constellation edges gracefully. */
  .constellation {
    display: flex;
    justify-content: center;
    overflow: clip;
  }
  .constellation__stage {
    position: relative;
    flex: 0 0 auto;
    width: 1440px; /* Figma frame 19:215 */
    height: 650px;
  }
  .constellation__heading {
    position: absolute;
    top: 283px; /* Figma 20:361 */
    left: 50%;
    transform: translateX(-50%);
    width: 704px; /* Figma 20:361 */
    max-width: calc(100vw - 2 * var(--margin-desktop));
  }
  .constellation__pills {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .constellation__spot {
    position: absolute;
    top: var(--y);
    left: var(--x);
  }
  /* Disc size + violet fill now live in the ChannelPill kit (disc 40px default,
     variant="social" → var(--surface-pill-social)) — no scoped overrides. */

  /* TWO states only (client 2026-07-26: «как обычно на десктопе, второе —
     теги снизу»). The old middle state (fluid percent scatter, 947–1439) is
     gone: the Figma stage survives down to 1301 on its own — the outermost
     pills sit at x85 and x1130+180, and the stage only loses ~70px per side
     at 1301, so nothing clips. Below 1301 the cloud takes over. */

  /* MODE B — ≤1300px, "cloud" (client 2026-07-26: перестраивать на 1300,
     «заголовок и текст вверх, теги под ними»): pills stop tracking Figma /
     percent coordinates and become a centered flex-wrap cloud. Reading order
     is headline → body/chips → tags, so the heading sits at the TOP of the
     stage and the cloud is pushed to the BOTTOM (margin-top:auto); the gap
     between them is where PlatformIntro's body+chips land — the scene script
     re-measures the heading each time (--pi-shift), so they follow it here
     without any change to the script. */
  @media (max-width: 1300px) {
    .constellation__stage {
      width: 100%;
      height: auto; /* content height — the pinned section centres it */
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      /* The pinned section centres this box in 100vh, but the fixed menu owns
         the top 96px — reserving it here keeps the centring optically true and
         stops the headline sliding under the menu on short screens. */
      padding: 96px var(--menu-pad) 0;
    }
    .constellation__heading {
      position: static;
      left: auto;
      transform: none;
      order: 1;
      width: 100%;
    }
    .constellation__pills {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--sp-2);
      width: 100%;
    }
    /* Wave 1 (the dark trio) is its own centred row; wave 2 flows beneath it,
       so the opening beat reads as a deliberate line, not a rubble of tags
       (client 2026-07-26). */
    .constellation__pills--w1 {
      order: 2;
      /* Reserve exactly the height of the overlaid body+chips (measured by
         the scene script into --intro-h), then one section step of air — the
         cloud follows the copy instead of hugging the bottom edge, which left
         a huge hole on tall screens (client-caught 2026-07-26). */
      margin-top: calc(var(--intro-h, 260px) + clamp(var(--sp-4), 4.4svh, var(--sp-10)));
    }
    .constellation__pills--w2 {
      order: 3;
      margin-top: var(--sp-2);
    }
    .constellation__spot {
      position: static;
    }
  }
</style>

<style is:global>
  /* «One platform» pinned scroll scene (docs/SCROLL-SCENE-SPEC.md).
     .is-scene is added by JS ONLY when motion is allowed — no-JS and
     prefers-reduced-motion keep the static two-block flow untouched.
     Pin = CSS position:sticky (NOT gsap pin — Verifly reload-race lesson):
     both sections stick at top:0 inside the tall scene wrapper, PlatformIntro
     overlays Constellation via margin-top:-100vh, ScrollTrigger only scrubs. */
  [data-scene='one-platform'].is-scene {
    /* 450 → 360 → 300 → 260 (2026-07-08) → 220vh (client 2026-07-21: the
       pills-clear beat is gone — the scene assembles and releases; the track
       shrinks proportionally so the wheel pace per beat stays the same and
       the screen lets go ~40vh sooner). Timeline starts the moment the scene
       peeks in from below — the WHOLE track is live scrub.
       svh, NOT vh (client-caught 2026-07-27 on a phone: «тапаю вниз — меня
       зашпуливает на One Platform»). On iOS every show/hide of the address
       bar changes vh, so this track — the tallest box on the page — kept
       resizing under the reader and threw the scroll position a whole screen.
       svh is the one height that does not move while the toolbars do. */
    height: 220svh; /* 100svh pre-pin reveal + 120svh pinned */
  }
  .is-scene [data-scene-part='constellation'] {
    position: sticky;
    top: 0;
    height: 100svh;
    align-items: center;
  }
  .is-scene [data-scene-part='intro'] {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    margin-top: -100svh; /* overlay on the constellation inside the same pin */
    overflow: clip;
  }
  /* The Constellation headline IS the scene headline (it stays, spec §5).
     PlatformIntro's own duplicate heading only reserves layout space. */
  .is-scene [data-scene-part='intro'] .heading {
    visibility: hidden;
  }
  /* JS-measured shift keeping the hidden intro heading on the exact Y of the
     persistent constellation headline, so body + chips land under it. */
  .is-scene [data-scene-part='intro'] .platform-intro__inner {
    transform: translateY(var(--pi-shift, 0px));
  }

  /* Tiny screens: headline + body + chips + 13 tags simply do not fit one
     pinned 100vh screen at any type size (measured 2026-07-26 at 320×700 —
     the tag cloud landed on the chips). There the scene UNPINS and reads as
     a normal scrolling block: the scrub still plays, nothing is clipped,
     nothing overlaps. The duplicate intro headline stays hidden — the
     constellation one is the scene's headline (spec §5). */
  @media (max-width: 430px) and (max-height: 720px) {
    [data-scene='one-platform'].is-scene {
      height: auto;
    }
    .is-scene [data-scene-part='constellation'],
    .is-scene [data-scene-part='intro'] {
      position: static;
      height: auto;
      margin-top: 0;
    }
    .is-scene [data-scene-part='constellation'] .constellation__stage {
      height: auto;
      padding-bottom: 0;
    }
    .is-scene [data-scene-part='intro'] .heading {
      display: none;
    }
    .is-scene [data-scene-part='intro'] .platform-intro__inner {
      transform: none;
    }
  }
</style>

<script>
  // «One platform» scroll scene (docs/SCROLL-SCENE-SPEC.md; feel reference —
  // branch.computer randomized fly-ins). CSS sticky + ScrollTrigger scrub, no
  // gsap pin. transform/opacity only, no blur. A scrubbed timeline only
  // advances with scroll inside the scene range, so nothing ticks while the
  // scene is off-viewport or the tab is hidden.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  /** Deterministic PRNG seeded per element index — pill speeds/delays must not
      reshuffle between page loads (spec: рандом-сид на индекс). */
  function mulberry32(seed: number) {
    let a = seed | 0;
    return () => {
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  /** Wrap each word of `text` in a span (typing effect targets). */
  function splitWords(text: string) {
    const frag = document.createDocumentFragment();
    const words: HTMLElement[] = [];
    text
      .trim()
      .split(/\s+/)
      .forEach((word, i) => {
        if (i > 0) frag.append(' ');
        const span = document.createElement('span');
        span.className = 'scene-word';
        span.textContent = word;
        frag.append(span);
        words.push(span);
      });
    return { frag, words };
  }

  function initScene(scene: HTMLElement) {
    const intro = scene.querySelector<HTMLElement>('[data-scene-part="intro"]');
    const headline = scene.querySelector<HTMLElement>('[data-scene-el="headline"] h2');
    const accent = headline?.querySelector<HTMLElement>('.heading__accent');
    const body = scene.querySelector<HTMLElement>('[data-scene-el="body"]');
    const chipsWrap = scene.querySelector<HTMLElement>('[data-scene-el="chips"]');
    const introHeading = intro?.querySelector<HTMLElement>('h2');
    const introInner = intro?.querySelector<HTMLElement>('.platform-intro__inner');
    const pills = [...scene.querySelectorAll<HTMLElement>('[data-scene-el="pill"]')];
    if (!intro || !headline || !accent || !body || !chipsWrap || !introHeading || !introInner || pills.length === 0) return;

    gsap.registerPlugin(ScrollTrigger);
    // The other half of the svh fix above: a mobile address bar sliding in or
    // out is NOT a resize worth recomputing the scene for. Without this every
    // one of them refreshes the trigger mid-read and moves the page under the
    // reader (client-caught 2026-07-27).
    ScrollTrigger.config({ ignoreMobileResize: true });

    // Headline word split: part 1 = plain text nodes, part 2 = violet accent.
    const line1: HTMLElement[] = [];
    for (const node of [...headline.childNodes]) {
      if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
        const { frag, words } = splitWords(node.textContent);
        line1.push(...words);
        headline.replaceChild(frag, node);
      }
    }
    const { frag: accentFrag, words: line2 } = splitWords(accent.textContent ?? '');
    accent.replaceChildren(accentFrag);
    line1.forEach((w) => (w.dataset.sceneEl = 'headline-1'));
    line2.forEach((w) => (w.dataset.sceneEl = 'headline-2'));

    const wave1 = pills.filter((p) => p.dataset.wave === '1'); // 3 dark pills
    const wave2 = pills.filter((p) => p.dataset.wave === '2'); // 10 violet pills
    const chips = [...chipsWrap.children];

    // Switch on the sticky-scene layout (static flow = fallback state).
    scene.classList.add('is-scene');

    // Keep the persistent constellation headline and the hidden PlatformIntro
    // heading on the same Y, so the body/chips appear under the headline that
    // stays (spec §5–7). Both sections are stuck at the same top → the delta
    // is scroll-independent.
    const stage = scene.querySelector<HTMLElement>('.constellation__stage');
    const align = () => {
      introInner.style.setProperty('--pi-shift', '0px');
      const delta = headline.getBoundingClientRect().top - introHeading.getBoundingClientRect().top;
      introInner.style.setProperty('--pi-shift', `${delta}px`);
      // Cloud mode (≤1300) stacks headline → [overlaid body+chips] → tags, so
      // the tag row must reserve the overlay's real height — measured here
      // because the overlay lives in a different section (client 2026-07-26:
      // «уменьшить отступ от тегов до текста»).
      if (stage) {
        const h = chipsWrap.getBoundingClientRect().bottom - introHeading.getBoundingClientRect().bottom;
        stage.style.setProperty('--intro-h', `${Math.max(0, Math.round(h))}px`);
      }
    };
    align();
    document.fonts?.ready.then(() => {
      align();
      ScrollTrigger.refresh();
    });
    window.addEventListener('resize', align);

    // Initial states (transform/opacity only — no blur, no filters).
    gsap.set([...line1, ...line2], { opacity: 0 });
    gsap.set(pills, { opacity: 0, scale: 1.6 });
    gsap.set(body, { opacity: 0, y: 40 });
    gsap.set(chips, { opacity: 0, y: 24 });

    // One scrubbed timeline; position values are abstract beats (7.2 total)
    // mapped onto the full 220vh track (beat ≈ 30vh; the pin engages at ~3.3).
    // Trigger starts the moment the scene peeks in from below (client
    // 2026-07-08: no dead dark stretch). scrub 0.6 = soft catch-up: on a fast
    // wheel flick the states PLAY toward the target instead of teleporting —
    // without it the headline just «appears» fully formed (client 2026-07-08
    // rev 2: «не вкручивается»).
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: scene,
        start: 'top bottom',
        end: 'bottom bottom',
        scrub: 0.6,
      },
    });

    // 1 — headline part 1 «types» in word by word (spec §1). Beat 1.6 on the
    // 260vh track ≈ the headline's Y crossing the fold (515px below the scene
    // top) — the first word or two light up a breath below the edge (client
    // 2026-07-08 rev 3: «ещё немножечко раньше»), the rest visibly types as
    // the line rides up and the brands strip is still leaving.
    tl.to(line1, { opacity: 1, duration: 0.12, stagger: 0.16 }, 1.6);

    // 2 — wave 1: the 3 dark pills fly in — opacity 0 + scale 1.6 → settle,
    // each with its own seeded duration/delay (branch.computer feel, spec §2).
    // Launches pre-pin, right on the typing's tail — tags arriving as the
    // strip's last rows exit (client 2026-07-08).
    wave1.forEach((pill, i) => {
      const r = mulberry32(i + 1);
      tl.to(
        pill,
        { opacity: 1, scale: 1, duration: 0.8 + r() * 0.6, ease: 'power2.out' },
        2.5 + r() * 0.5
      );
    });

    // 3 — headline part 2 (violet bold) types in — and the explanation
    // arrives WITH it (client 2026-07-21): body fades up and the three chips
    // чик-чик-чик right on the second line's heels. Pills never overlap them
    // — the pill map above keeps the centre column clear.
    tl.to(line2, { opacity: 1, duration: 0.12, stagger: 0.16 }, 4.0);
    tl.to(body, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, 4.05);
    tl.to(chips, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', stagger: 0.25 }, 4.2);

    // 4 — wave 2: the 10 violet pills, same effect (spec §4).
    wave2.forEach((pill, i) => {
      const r = mulberry32(101 + i);
      tl.to(
        pill,
        { opacity: 1, scale: 1, duration: 0.7 + r() * 0.6, ease: 'power2.out' },
        4.8 + r() * 0.7
      );
    });

    // 5 — NO pills-clear beat (client 2026-07-21: «появились все теги — и всё,
    // дальше крутим»): the assembled composition — headline, body, chips and
    // every pill — simply stays, a short settle, and the page releases.
    tl.to({}, { duration: 0.4 }, 6.8);
  }

  const scene = document.querySelector<HTMLElement>('[data-scene="one-platform"]');
  // Guard BEFORE creating any timeline/layout: reduced motion or no JS keeps
  // the current static two-block flow (spec: статика без пина).
  if (scene && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    initScene(scene);
  }
</script>
